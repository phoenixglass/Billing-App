# Billing App Environment Variables
# This file shows what credentials should be set. DO NOT commit actual credentials to git.
# Copy to .env and fill with real values (already in .gitignore).

# BILLING_APP_CREDENTIALS: JSON object mapping usernames to PBKDF2 password hashes
# Generate hashes by running: python3 env_setup.py
# Format: {"username1":"pbkdf2_sha256$600000$salt$hash","username2":"pbkdf2_sha256$600000$salt$hash"}
#
# Example (do not use in production):
# BILLING_APP_CREDENTIALS='{"jasmine":"pbkdf2_sha256$600000$a1b2c3d4e5f6g7h8$hash1","cb":"pbkdf2_sha256$600000$x9y8z7w6$hash2"}'

BILLING_APP_CREDENTIALS=''
