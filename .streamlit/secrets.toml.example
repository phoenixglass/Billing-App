# Streamlit secrets file. This is what app.py actually reads via st.secrets
# (separate from .env / .env.example, which document the same
# BILLING_APP_CREDENTIALS value for non-Streamlit use).
#
# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is in .gitignore — never commit the real file.
#
# App login was removed on 2026-07-07, so BILLING_APP_CREDENTIALS is not
# currently read by the app. Only the GCS audit-logging keys below are used;
# they are optional — without them the app logs to local files/console only.

# gcp_service_account: full JSON key for a service account with write access
# to the audit-log bucket named below. Paste the key file's JSON as a string.
# gcp_service_account = '{"type": "service_account", "project_id": "...", ...}'

# gcs_bucket_name: bucket to write audit logs to. Defaults to
# "billing-app-audit-logs" if omitted.
# gcs_bucket_name = "billing-app-audit-logs"
